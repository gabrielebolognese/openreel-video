{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@openreel/core": ["../core/src/index.ts"],
      "@openreel/core/*": ["../core/src/*"],
      "@openreel/mograph": ["./src/index.ts"],
      "@openreel/mograph/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
